<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.rezka_local"
       name="Rezka Local Base"
       version="1.2.3"
       provider-name="Kurumi">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="ru">Просмотр локальной базы потоков с Резки</summary>
        <description lang="ru">Плагин читает rezka_database.db (SQLite) и воспроизводит m3u8 потоки в Kodi.</description>
    </extension>
</addon>